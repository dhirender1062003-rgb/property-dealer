DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be identical to JWT_SECRET in backend-node/.env
JWT_SECRET=change-me-shared-jwt-secret
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Database ---
# Leave empty for local SQLite. Production PostgreSQL example:
# DATABASE_URL=postgres://user:password@host:5432/property_dealer?sslmode=require
DATABASE_URL=

# --- Uploads ---
MAX_IMAGE_UPLOAD_MB=5
MAX_IMAGES_PER_PROPERTY=30

# --- Rate limits (requests per IP) ---
THROTTLE_INQUIRIES=10/hour
THROTTLE_AUTH=20/minute
# Number of reverse proxies in front of Django in production (0 for none)
NUM_PROXIES=0

# --- Production security (used when DJANGO_DEBUG=False) ---
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
BEHIND_HTTPS_PROXY=False
