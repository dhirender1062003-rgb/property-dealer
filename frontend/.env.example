# --- API connections ---
VITE_DJANGO_API_URL=http://localhost:8000/api
VITE_NODE_SERVER_URL=http://localhost:5000

# Show clearly-labelled sample properties while the Django property API
# is not available. Set to false in production.
VITE_USE_SAMPLE_DATA=true

# --- Default contact details ---
# Used until they are set in Django admin (site settings, Phase 3/4).
# Replace the placeholder phone/WhatsApp numbers with your real ones.
VITE_BUSINESS_NAME=Property Dealer
VITE_CONTACT_PHONE=+91 00000 00000
VITE_WHATSAPP_NUMBER=910000000000
VITE_CONTACT_EMAIL=info@propertydealer.example
VITE_OFFICE_ADDRESS=Ghaziabad, Uttar Pradesh, India
VITE_BUSINESS_HOURS=Mon - Sun: 10:00 AM - 7:00 PM
